"%R61_NODE%" -e "const fs=require('node:fs');const p=require('node:path');const cr=require('node:crypto');const h=b=>cr.createHash('sha256').update(b).digest('hex');const root=fs.realpathSync(process.env.R61_INSTALL);const src=fs.readFileSync(process.env.R61_SELF,'ascii');const specs=['F01|scripts/pc-writer/theme-nine-r54-public-connect.mjs|14e82239e8d825f512901ba4aa50cf59ccaefe72924fcb61cf8ea1ee9a184040|195332100e32473c59c4820d8961de2dd7cac978b7f87b782cfa968c737f6b77','F02|scripts/pc-writer/theme-nine-r51-stage-current.mjs|270cd12e7fece5ade0f069bcc0d6ae8550d354e82f943e182e1df14920b978c0|fe079b1e2e5d2f824f6e0ff251bd2a01677fe1a477072c619b614402fbd90ae4','F03|scripts/pc-writer/theme-nine-r51-provisional-overlay.mjs|0aa430e4bd2c37ea140e20237122df559a83481f7af18b3318f9f1fda5ca6c79|2fe839a5112bcb8159202935a4d56b8c6b7c723fd121b9a9699c98bc35a81473','F04|worker/theme-nine-r37-public.mjs|1a5ceb5a8cd580bd9f63a5a21950412778e16b3b52b019c6c7ef87abcaf1cc8a|4b63d70567e18c4ee70df74b2f982c3e8aeb34678e022677e06b34c3f14d7f2b'];const parts=specs.map(spec=>{const [key,rel,oldSha,newSha]=spec.split('|'),begin='::R61_'+key+'_BEGIN',end='::R61_'+key+'_END',i=src.lastIndexOf(begin),j=src.indexOf(end,i+begin.length);if(i<0||j<0)throw Error('R61_EMBEDDED_FILE_MISSING_'+rel);const bytes=Buffer.from(src.slice(i+begin.length,j).replace(/[^A-Za-z0-9+/=]/g,''),'base64');if(h(bytes)!==newSha)throw Error('R61_BUNDLE_SHA_'+rel);const file=p.resolve(root,rel);if(!file.startsWith(root+p.sep))throw Error('R61_PATH_ESCAPE_'+rel);if(!fs.existsSync(file)||!fs.statSync(file).isFile()||fs.lstatSync(file).isSymbolicLink())throw Error('R61_INSTALLED_FILE_MISSING_'+rel);const actual=h(fs.readFileSync(file));if(actual!==oldSha&&actual!==newSha)throw Error('R61_UNKNOWN_INSTALLED_SHA_'+rel);const bak=file+'.R61_BACKUP',tmp=file+'.R61_STAGED';if(fs.existsSync(bak)&&h(fs.readFileSync(bak))!==oldSha)throw Error('R61_BACKUP_SHA_CONFLICT_'+rel);if(fs.existsSync(tmp))throw Error('R61_STAGED_FILE_EXISTS_'+rel);if(actual=