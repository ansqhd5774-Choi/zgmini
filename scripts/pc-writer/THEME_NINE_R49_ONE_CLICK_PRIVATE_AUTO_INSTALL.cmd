@echo off
setlocal EnableExtensions DisableDelayedExpansion
rem Existing nine themes: install R47 + R48 PRIVATE automation only.
rem One-time install; no forced 64-GET run; no D1/publication writes.
rem Preserves all existing scheduled tasks; no forced task overwrite.
set "R49_SELF=%~f0"
set "R49_INSTALL=E:\ZGmini\data\pc-writer\theme-nine-r48"
set "R49_NODE=E:\ZGmini\runtime\node.exe"
set "R49_REPORT=%~dp0THEME_NINE_R49_INSTALL_RESULT_%RANDOM%_%RANDOM%.txt"
if exist "%R49_REPORT%" goto :collision
>"%R49_REPORT%" echo REPORT=THEME_NINE_R49_ONE_CLICK_PRIVATE_AUTO_INSTALL
>>"%R49_REPORT%" echo SOURCE=R47_RECURRING_TO_R48_PRIVATE_STAGE
>>"%R49_REPORT%" echo INSTALL_PATH=%R49_INSTALL%
>>"%R49_REPORT%" echo D1_WRITES=0
>>"%R49_REPORT%" echo PUBLICATION_WRITES=0
>>"%R49_REPORT%" echo EXISTING_OPERATING_TASKS_CHANGED=0
>>"%R49_REPORT%" echo FULL_PROVIDER_COLLECTION_DURING_INSTALL=NO
if not exist "E:\ZGmini\data\" goto :missing_data
if not exist "%R49_NODE%" goto :missing_node
"%R49_NODE%" --version >>"%R49_REPORT%" 2>&1
if errorlevel 1 goto :missing_node
if not exist "%R49_INSTALL%\" mkdir "%R49_INSTALL%" >>"%R49_REPORT%" 2>&1
if errorlevel 1 goto :mkdir_error
"%R49_NODE%" -e "const fs=require('node:fs');const p=require('node:path');const cr=require('node:crypto');const s=fs.readFileSync(process.env.R49_SELF,'ascii');const root=process.env.R49_INSTALL;const sha=b=>cr.createHash('sha256').update(b).digest('hex');const specs=['R47|THEME_NINE_R47_RECURRING_PRIVATE_UPDATE.cmd|2133e5d4e625762340e715ecd21e809f274713c030e904e3e3f314dc3b6a0729','CYCLE|THEME_NINE_R48_PRIVATE_CYCLE.cmd|7356da2ae151eceb2b3306b40c13de3394eef3476e15ca1528128006748ed0c4','BRIDGE|theme-nine-r48-r47-bridge.mjs|9451bac02a76052a7798e847b9259408a28573041027420831feb0699b36a881','STAGE|theme-nine-r48-stage-current.mjs|d3a5afad2adee9c9e14382384b7ba8c87f88e016a8880571d975b7d64010f2ea','SCHEDULE|theme-nine-r48-private-schedule.mjs|c09eba0293f204da45308a00f51c52c9b604ac97649cb186032185d47d179b92','ROSTER|theme-nine-r20-approved-candidates.json|e2ea97ce0ed0bf15cb083237d63d3cf520e090d8bd229a837bad393c3f8b0c6c','AUM|theme-nine-r26-official-aum-evidence.json|2a8b3ec24a72e34de39e0b2c393275550ea03ea560922b8379db9bbafdfdfef9'];const parsed=specs.map(v=>{const [k,n,h]=v.split('|');const a='::R49_'+k+'_BEGIN',z='::R49_'+k+'_END';const i=s.lastIndexOf(a),j=s.indexOf(z,i+a.length);if(i<0||j<0)throw Error('BUNDLE_SECTION_MISSING_'+k);const b=Buffer.from(s.slice(i+a.length,j).replace(/[^A-Za-z0-9+/=]/g,''),'base64');if(sha(b)!==h)throw Error('BUNDLE_SHA_MISMATCH_'+k);return {n,b,h}});for(const v of parsed){const target=p.join(root,v.n);if(fs.existsSync(target)){if(!fs.statSync(target).isFile()||sha(fs.readFileSync(target))!==v.h)throw Error('EXISTING_FILE_CONFLICT_'+v.n)}};for(const v of parsed){const target=p.join(root,v.n);if(!fs.existsSync(target))fs.writeFileSync(target,v.b,{flag:'wx'})};console.log('BUNDLE_SHA_VERIFIED=YES');console.log('FILES_INSTALLED_OR_VERIFIED='+parsed.length+'/'+parsed.length)" >>"%R49_REPORT%" 2>&1
if errorlevel 1 goto :extract_error
>>"%R49_REPORT%" echo TASK_INSTALL_ATTEMPT=YES
"%R49_NODE%" "%R49_INSTALL%\theme-nine-r48-private-schedule.mjs" --install >>"%R49_REPORT%" 2>&1
if errorlevel 1 goto :schedule_error
>>"%R49_REPORT%" echo TASK_INSTALL_COMMAND=SUCCESS_CHECK_TASK_STATUS_ABOVE
>>"%R49_REPORT%" echo R48_STAGE_EXISTING_ATTEMPT=YES
set "ZGMINI_R48_CONFIG_DIR=%R49_INSTALL%"
"%R49_NODE%" "%R49_INSTALL%\theme-nine-r48-stage-current.mjs" --stage-private >>"%R49_REPORT%" 2>&1
if errorlevel 1 goto :stage_pending
>>"%R49_REPORT%" echo R48_STAGE_EXISTING_STATUS=SUCCESS_PRIVATE_ONLY
>>"%R49_REPORT%" echo STATUS=INSTALL_COMPLETED_TASK_COMMAND_SUCCESS_STAGE_SUCCESS
set "R49_EXIT=0"
goto :done
:stage_pending
>>"%R49_REPORT%" echo R48_STAGE_EXISTING_STATUS=PENDING_REVIEW
>>"%R49_REPORT%" echo STATUS=INSTALL_COMPLETED_TASK_COMMAND_SUCCESS_STAGE_PENDING
set "R49_EXIT=0"
goto :done
:missing_data
>>"%R49_REPORT%" echo STATUS=STOP_EXPECTED_E_DATA_ROOT_MISSING
set "R49_EXIT=2"
goto :done
:missing_node
>>"%R49_REPORT%" echo STATUS=STOP_EXPECTED_PC_NODE_MISSING
set "R49_EXIT=2"
goto :done
:mkdir_error
>>"%R49_REPORT%" echo STATUS=STOP_INSTALL_DIRECTORY_CREATE_FAILED
set "R49_EXIT=3"
goto :done
:extract_error
>>"%R49_REPORT%" echo STATUS=STOP_BUNDLE_SHA_OR_TARGET_CONFLICT
set "R49_EXIT=4"
goto :done
:schedule_error
>>"%R49_REPORT%" echo STATUS=STOP_SCHEDULE_COMMAND_FAILED
set "R49_EXIT=5"
goto :done
:collision
echo STATUS=STOP_R49_REPORT_FILE_COLLISION_RETRY
exit /b 2
:done
type "%R49_REPORT%"
echo RESULT_FILE=%R49_REPORT%
exit /b %R49_EXIT%
