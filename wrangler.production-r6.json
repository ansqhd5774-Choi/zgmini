{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "zgmini-production-r6",
  "account_id": "6e9b57e718b247330a6efa42a9516e95",
  "main": "worker/production-r6.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "routes": [],
  "triggers": {"crons": []},
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB_CORE",
      "database_name": "zgmini-core-r42",
      "database_id": "d7a25e98-8d52-47a4-9e37-695e4d84d18b"
    },
    {
      "binding": "DB_HISTORY",
      "database_name": "zgmini-history-r42",
      "database_id": "55f17650-dc84-46c9-829a-d448ca1b2417"
    }
  ],
  "queues": {
    "producers": [{"binding":"PUBLIC_PROJECTION_QUEUE","queue":"zgmini-public-projection-r1"}],
    "consumers": [{
      "queue":"zgmini-public-projection-r1",
      "max_batch_size":1,
      "max_batch_timeout":1,
      "max_concurrency":1,
      "max_retries":3
    }]
  }
}
