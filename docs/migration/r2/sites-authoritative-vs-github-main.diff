-.cnn-component-overview-name{display:flex;align-items:center;gap:10px}
-.cnn-component-overview-name>span{display:grid;width:28px;height:28px;place-items:center;border:1px solid #2d536d;color:#bcd0e0;font-size:11px;font-weight:800;flex:none}
