-.cnn-component-overview{margin-top:16px;border:1px solid var(--zg-border);background:#061722}
-.cnn-component-overview-head{display:flex;align-items:end;justify-content:space-between;gap:16px;padding:14px 16px;border-bottom:1px solid #19384c}
-.cnn-component-overview-head h2{margin-top:3px;font-size:15px;line-height:1.3;font-weight:800}
-.cnn-component-overview-head>span{max-width:360px;color:var(--zg-text-meta);font-size:11px;line-height:1.45;text-align:right}
-.cnn-component-overview-list{display:grid}
-.cnn-component-overview-row{display:grid;grid-template-columns:minmax(180px,1.4fr) minmax(120px,1fr) 92px 108px;align-items:center;min-height:52px;border-bottom:1px solid #19384c}
